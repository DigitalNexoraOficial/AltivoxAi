# AltivoxAI — environment template
# Copy to `.env.local` (local) or set in Vercel. Never commit real secrets.

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
# Optional public alias (same anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only: Ops/SQL stores, audit. NEVER use for public lead inserts.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Alias accepted by some modules
# SUPABASE_SECRET_KEY=

# --- AI / LLM (Tool Registry · chat público) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# --- n8n automation ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TEST=
N8N_SECRET=

# --- Rate limiting (prod: Upstash) ---
RATE_LIMIT_MODE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Agent Runtime ---
# memory | sql (default sql when SERVICE_ROLE set; selftests force memory)
ALTIVOX_AGENT_STORE=memory
# ALTIVOX_SELFTEST=1

# --- Review Engine ---
# memory | sql
ALTIVOX_REVIEW_STORE=memory

# --- Deploy Engine ---
# memory | sql
ALTIVOX_DEPLOY_STORE=memory
# Filesystem package dir when not selftest (optional)
ALTIVOX_DEPLOY_PACKAGE_DIR=

# --- Public marketing ---
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CAL_URL=
